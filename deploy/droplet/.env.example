# Rendered to /srv/bankjar/.env (mode 600) by add-product.sh on the first deploy.
# Read by the container at run time. Every variable is optional: BankJar answers
# the same questions without an LLM, and without a visitor salt.
#
# NEXT_PUBLIC_SITE_URL is NOT set here. Next inlines it at BUILD time, so it is
# set by scripts/deploy.sh on the laptop (https://bankjar.fabriquefutur.com).
# Changing it means a new `scripts/deploy.sh`, not an edit of this file.

# Optional AI intent parsing through the accounts hub (Haiku 5.5, service path,
# product `bankjar`). Without it the rule parser alone answers.
# ACCOUNTS_SERVICE_BANKJAR=

# Set to 0 to turn AI parsing off even when the key above is present.
# BANKJAR_AI=1

# Secret used to hash visitors for the usage counters; any long random string.
# BANKJAR_VISITOR_SALT=
