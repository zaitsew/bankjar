# Copy this to .env and fill in what applies. Nothing here is a secret value —
# it's the list of names ./check.sh looks for and reports as missing.
#
# EXAMPLE_API_KEY=
#
# AI search through the accounts hub. Optional: without it the rule parser answers.
# ACCOUNTS_SERVICE_BANKJAR=  # optional; AI search through the accounts hub. Without it the rule parser answers.
# ACCOUNTS_URL=  # base URL of the accounts hub, e.g. https://hub.example.com. No default: unset means AI search is off.
# BANKJAR_AI=off
# BANKJAR_VISITOR_SALT=

# OpenAI plugin directory domain check. After the MCP server is connected in
# platform.openai.com/plugins the portal shows a token; the route
# /.well-known/openai-apps-challenge returns it as plain text (404 while unset).
# On the droplet, put it in /srv/bankjar/.env (see docs/DIRECTORY.md). Not a secret.
# OPENAI_APPS_CHALLENGE=

# Public contact address shown on /privacy, /terms and /support. Read at BUILD time:
# NEXT_PUBLIC_CONTACT_EMAIL=name@example.com ./scripts/deploy.sh
# NEXT_PUBLIC_CONTACT_EMAIL=
